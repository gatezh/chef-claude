// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/marcosgomesneto/bun-devcontainers/tree/main/src/basic-bun
{
  "name": "chef-claude",
  "dockerFile": "Dockerfile",

  // Keep node_modules out of a host machine
  "mounts": [
    "source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],

  // Configure tool-specific properties.
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "oven.bun-vscode"
      ]
    }
  }

  // Run this after the container is created
  // "postCreateCommand": "bun install",

  // Automatically start the dev server when you attach
  // "postAttachCommand": {
  //   "server": "bun run dev"
  // }
}